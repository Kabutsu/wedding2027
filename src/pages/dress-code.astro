---
import { PUBLIC_PINTEREST_LINK } from "astro:env/client";

import suitImg from "@/assets/images/au-ball-2.jpg";

import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/PageHeader.astro";
import DetailsCard from "@/components/details-card/index.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <PageHeader title="Dress Code" />

  <section
    id="content"
    class="flex flex-col items-center justify-start gap-8 p-6 sm:gap-12 sm:p-12 sm:px-82"
  >
    <div
      class="flex flex-col items-start justify-start gap-4 sm:gap-6 max-w-5xl font-(family-name:--font-providence) text-mauve-950 font-light"
    >
      <p>We're planning a relaxed and joyful winter celebration.</p>
      <p>
        We encourage guests to dress up, embrace colour, and have fun with
        texture and personality. Think rich winter tones, romantic florals,
        velvet, silk, satin, embroidery, or statement accessories. Suits,
        dresses, jumpsuits, separates, and creative interpretations are all
        welcome.
      </p>
      <p>
        Most importantly, wear something that makes you feel wonderful and ready
        to celebrate!
      </p>
    </div>

    <div id="pinterest-container" class="desktop">
      <a
        id="pinterest-embed"
        data-pin-do="embedBoard"
        href={PUBLIC_PINTEREST_LINK}
        data-pin-scale-width="400"
        data-pin-scale-height="600"
      >
      </a>
    </div>
    <div id="pinterest-container" class="mobile">
      <DetailsCard
        title="Inspiration"
        description={`View our "Romantic Winter Cocktail" board on Pinterest`}
        buttonText="Check it Out"
        buttonLink={PUBLIC_PINTEREST_LINK}
        img={suitImg}
        newPage
      />
    </div>

    <script is:inline type="text/javascript">
      function initPinterestEmbed() {
        if (window.PinUtils && window.PinUtils.build) {
          window.PinUtils.build();
          return;
        }

        const script = document.createElement("script");
        script.src = "https://assets.pinterest.com/js/pinit.js";
        script.async = true;
        script.onload = function () {
          if (window.PinUtils && window.PinUtils.build) {
            setTimeout(() => {
              window.PinUtils.build();
            }, 100);
          }
        };
        document.body.appendChild(script);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initPinterestEmbed);
      } else {
        setTimeout(initPinterestEmbed, 100);
      }

      window.addEventListener("load", function () {
        if (window.PinUtils && window.PinUtils.build) {
          window.PinUtils.build();
        }
      });
    </script>
  </section>

  <Footer />
</Layout>

<style>
  #pinterest-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  @media screen and (max-width: 640px) {
    #pinterest-container.desktop {
      display: none !important;
    }

    #pinterest-container.mobile {
      display: flex !important;
    }
  }

  @media screen and (min-width: 641px) {
    #pinterest-container.desktop {
      display: flex !important;
    }

    #pinterest-container.mobile {
      display: none !important;
    }
  }

  #content p {
    text-wrap: pretty;
    font-size: 1.3rem;
  }
</style>
