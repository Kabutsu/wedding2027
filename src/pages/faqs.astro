---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";

const faqs = await getCollection("faqs");
---

<Layout>
  <header
    id="header"
    class="w-full py-8 sm:pt-24 flex flex-col items-center justify-start bg-red-pastel text-shadow-red-pastel-dark"
  >
    <h1 class="text-5xl sm:text-6xl font-(family-name:--font-roca) text-ivory">
      <span class="hidden sm:inline">Frequently Asked Questions</span>
      <span class="inline sm:hidden">FAQs</span>
    </h1>
  </header>
  <section
    class="w-full h-full min-h-screen -mb-14 pt-8 sm:pt-12 pb-24 sm:pb-36 px-6 sm:px-12 flex flex-col items-center justify-start gap-8 sm:gap-12 bg-red-pastel text-ivory"
  >
    <div
      class="flex flex-col items-start justify-start gap-4 sm:gap-6 max-w-5xl pb-6 sm:pb-8 font-(family-name:--font-providence) text-2xl"
    >
      <p>
        We know that planning for a wedding can be stressful, so we&apos;ve put
        together a list of frequently asked questions to help make things a
        little easier.
      </p>
      <p>
        If you have any other questions, please don&apos;t hesitate to reach out
        to us directly. We&apos;re happy to help!
      </p>
    </div>

    <div
      class="flex flex-col items-start justify-start text-left gap-12 sm:gap-18 w-full max-w-5xl"
    >
      {
        faqs
          .sort((a, b) => a.data.id - b.data.id)
          .map(({ data: faq }) => (
            <div class="flex flex-col items-start justify-start gap-4 sm:gap-6 w-full px-2 sm:px-28">
              <h2 class="text-2xl sm:text-4xl font-(family-name:--font-roca) text-shadow-md text-shadow-pink-pastel-dark italic">
                &quot;{faq.question}&quot;
              </h2>
              <p class="text-lg sm:text-2xl font-(family-name:--font-inter)">
                {faq.answer}
              </p>
            </div>
          ))
      }
    </div>
  </section>

  <Footer />
</Layout>
