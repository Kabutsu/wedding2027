---

<Layout>
  <PageHeader title="Accommodation" />

  <section
    id="content"
    class="flex flex-col items-center justify-start gap-12 p-6 sm:gap-16 sm:p-12 sm:px-82 w-full"
  >
    <!-- Intro paragraph -->
    <div
      class="flex flex-col items-center justify-start gap-4 max-w-5xl font-(family-name:--font-inter) text-mauve-950"
    >
      <p class="intro-para">
        We've compiled a list of wonderful accommodation options nearby, ranging
        from boutique hotels and charming inns to cosy cottages and bed &
        breakfasts. Whether you'd like to be close to the barn or prefer a
        scenic drive, you'll find something that suits you.
      </p>

      <DetailsCard
        title="Stay on Site"
        description="We have exclusive use of the barn and grounds for our wedding, and there are a few rooms available to book on site"
        buttonText="Book a Room"
        buttonLink={PUBLIC_HOTEL_URL}
        img={venueImg}
        newPage
      />
    </div>

    <!-- Hotels & Inns Table -->
    <div class="w-full max-w-5xl">
      <h2 class="table-heading">Hotels & Inns</h2>
      <div class="table-wrapper">
        <table class="data-table" data-table="hotels-inns">
          <thead>
            <tr>
              <th>Accommodation</th>
              <th>Phone</th>
              <th class="sortable" data-sort="cost">
                <span class="hidden sm:inline-block"
                  >Approximate Cost for 1 Night</span
                >
                <span class="sm:hidden">Cost</span>
                <span class="sort-indicator"></span>
              </th>
              <th class="sortable" data-sort="distance">
                Distance
                <span class="sort-indicator"></span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              hotelsAndInns.map((item) => {
                const [mainName, city] = item.name.split(", ");
                return (
                  <tr
                    data-cost={parseCost(item.cost)}
                    data-distance={item.distance}
                  >
                    <td class="name-cell">
                      <a
                        href={`https://${item.website.replace(/^https?:\/\//, "")}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {mainName}
                        {city && <span class="city">, {city}</span>}
                      </a>
                    </td>
                    <td class="phone-cell">{item.phone}</td>
                    <td class="cost-cell">{item.cost}</td>
                    <td class="distance-cell">{item.distance} mins</td>
