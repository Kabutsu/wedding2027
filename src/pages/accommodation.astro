<style>
  #content {
    max-width: 100%;
  }

  .intro-para {
    font-weight: 300;
    font-size: 1.3rem;
    text-wrap: pretty;
    font-family: var(--font-providence);
    padding-bottom: 1rem;
  }

  .table-heading {
    font-family: var(--font-roca);
    font-size: 2rem;
    color: var(--color-pink-pastel-dark);
    margin-bottom: 1rem;
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: 0.5rem;
    box-shadow: var(--drop-shadow-wedding);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    background-color: white;
  }

  .data-table thead {
    background-color: var(--color-red-pastel);
    color: white;
  }

  .data-table th {
    padding: 1rem;
    text-align: left;
    font-weight: 500;
    font-size: 1.25rem;
    font-family: var(--font-gentium);
  }

  .data-table th.sortable {
    cursor: pointer;
    user-select: none;
    position: relative;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }

  .data-table th.sortable:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .sort-indicator {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.9em;
    opacity: 0.6;
    min-width: 1em;
  }

  .sort-indicator.asc::after {
    content: "↑";
  }

  .sort-indicator.desc::after {
    content: "↓";
  }

  .data-table td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid #e5e7eb;
    font-size: 0.95rem;
  }

  .data-table tbody tr {
    transition: background-color 0.2s ease;
  }

  .data-table tbody tr:hover {
    background-color: #faf8f5;
  }

  .data-table tbody tr.even-row {
    background-color: #fdfbf8;
  }

  .data-table tbody tr.even-row:hover {
    background-color: #faf8f5;
  }

  .name-cell {
    font-weight: 600;
    color: var(--color-wedding-dark);
  }

  .phone-cell {
    font-family: monospace;
    font-size: 0.9rem;
  }

  .name-cell a {
    color: var(--color-wedding-burgundy);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .name-cell a:hover {
    color: var(--color-crimson);
    text-decoration: underline;
  }

  .name-cell a .city {
    display: none;
  }

  @media (min-width: 769px) {
    .name-cell a .city {
      display: inline;
    }
  }

  .distance-cell {
    text-align: center;
    font-weight: 500;
    color: #666;
  }

  .cost-cell {
    font-weight: 500;
    color: var(--color-wedding-dark);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .data-table th,
    .data-table td {
      padding: 0.75rem 0.5rem;
      font-size: 0.875rem;
    }

    .table-heading {
      font-size: 1.35rem;
    }
  }
</style>

<script is:inline>
  const tableState = {};

  function initializeTableSorting() {
    document.querySelectorAll(".data-table").forEach((table) => {
      const tableId = table.dataset.table;
      tableState[tableId] = { sortBy: "distance", sortDir: "asc" };

      const sortableHeaders = table.querySelectorAll("th.sortable");
      sortableHeaders.forEach((header) => {
        header.addEventListener("click", () => handleSort(table, header));
      });
    });

    // Apply initial sort (distance ascending) to all tables
    document.querySelectorAll(".data-table").forEach((table) => {
      sortTable(table, "distance", "asc");
      updateSortIndicators(table, "distance", "asc");
    });
  }

  function handleSort(table, header) {
    const tableId = table.dataset.table;
    const sortBy = header.dataset.sort;
    const currentState = tableState[tableId];

    let newDir = "asc";
    if (currentState.sortBy === sortBy && currentState.sortDir === "asc") {
      newDir = "desc";
    }

    tableState[tableId] = { sortBy, sortDir: newDir };
    sortTable(table, sortBy, newDir);
    updateSortIndicators(table, sortBy, newDir);
  }

  function sortTable(table, sortBy, direction) {
    const tbody = table.querySelector("tbody");
    const rows = Array.from(tbody.querySelectorAll("tr"));

    rows.sort((a, b) => {
      let aValue, bValue;

      if (sortBy === "distance") {
        aValue = parseInt(a.dataset.distance);
        bValue = parseInt(b.dataset.distance);
      } else if (sortBy === "cost") {
        aValue = parseInt(a.dataset.cost);
        bValue = parseInt(b.dataset.cost);
      }

      const comparison = aValue - bValue;
      return direction === "asc" ? comparison : -comparison;
    });

    // Re-append rows in sorted order
    rows.forEach((row) => tbody.appendChild(row));

    // Re-stripe rows
    rows.forEach((row, index) => {
      row.classList.toggle("even-row", index % 2 === 0);
    });
  }

  function updateSortIndicators(table, activeSortBy, direction) {
    const headers = table.querySelectorAll("th.sortable");
    headers.forEach((header) => {
      const indicator = header.querySelector(".sort-indicator");
      indicator.classList.remove("asc", "desc");

      if (header.dataset.sort === activeSortBy) {
        indicator.classList.add(direction);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeTableSorting);
  } else {
    initializeTableSorting();
  }
</script>
