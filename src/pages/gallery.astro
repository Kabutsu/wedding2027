---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import Layout from "@/layouts/Layout.astro";

import PageHeader from "@/components/PageHeader.astro";
import Footer from "@/components/Footer.astro";

import Gallery from "@/components/gallery/Gallery";

// Lazy load images on-demand instead of eager loading all into initial bundle
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/dogs/*.{jpg,JPG,jpeg,JPEG,png,PNG}",
);

// Resolve all lazy-loaded image promises
const images = await Promise.all(
  Object.values(imageModules).map(async (module) => (await module()).default),
);

// Optimize images at build time
const optimizedImages = await Promise.all(
  images.map(async (image, index) =>
    getImage({
      src: image,
      alt: `Photo ${index + 1}`,
      format: "webp",
      quality: "high",
      widths: [600, 1200, 1920],
      sizes: "(max-width: 640px) 600px, (max-width: 1280px) 1200px, 1920px",
    }).then((optimized) => ({
      ...optimized,
      loading: (index === 0 ? "eager" : "lazy") as "eager" | "lazy",
    })),
  ),
);

// Shuffle once at build time (Fisher-Yates) so row order is stable per build,
// not recomputed per request or per render.
for (let i = optimizedImages.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [optimizedImages[i], optimizedImages[j]] = [
    optimizedImages[j],
    optimizedImages[i],
  ];
}

// Split into 8 roughly equal rows for the gallery grid
const ROW_COUNT = 8;
const rows: (typeof optimizedImages)[] = Array.from(
  { length: ROW_COUNT },
  () => [],
);
optimizedImages.forEach((image, index) => {
  rows[index % ROW_COUNT].push(image);
});
---

<Layout>
  <PageHeader title="Gallery" />
  <section
    class="w-full min-h-[50svh] sm:min-h-96 flex flex-col justify-stretch"
  >
    <div
      id="gallery-content"
      class="w-full h-full pt-32 pb-10 sm:pb-22 flex flex-col flex-1 items-center justify-start gap-2.5"
    >
      {
        rows.map((row) => (
          <Gallery client:only="preact" images={row} direction="ltr" />
        ))
      }
    </div>
  </section>
  <Footer />
</Layout>
