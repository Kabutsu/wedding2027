---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import Layout from "@/layouts/Layout.astro";

import PageHeader from "@/components/PageHeader.astro";
import Footer from "@/components/Footer.astro";

import Gallery from "@/components/gallery/Gallery";

// Lazy load images on-demand instead of eager loading all into initial bundle
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/dogs/*.{jpg,JPG,jpeg,JPEG,png,PNG}",
);

// Resolve all lazy-loaded image promises
const images = await Promise.all(
  Object.values(imageModules).map(async (module) => (await module()).default),
);

// Optimize images at build time
const optimizedImages = await Promise.all(
  images.map(async (image, index) =>
    getImage({
      src: image,
      alt: `Photo ${index + 1}`,
      format: "webp",
      quality: "high",
      widths: [600, 1200, 1920],
      sizes: "(max-width: 640px) 600px, (max-width: 1280px) 1200px, 1920px",
    }).then((optimized) => ({
      ...optimized,
      // All images are gated behind the loading spinner until every one has
      // loaded (see the script below), so none can be `lazy` — a lazy image
      // never becomes eligible to fetch while its ancestor is display:none,
      // since the browser can't compute intersection for an unrendered subtree.
      loading: "eager" as "eager" | "lazy",
    })),
  ),
);

// Shuffle once at build time (Fisher-Yates) so row order is stable per build,
// not recomputed per request or per render.
for (let i = optimizedImages.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [optimizedImages[i], optimizedImages[j]] = [
    optimizedImages[j],
    optimizedImages[i],
  ];
}

// Split into 8 roughly equal rows for the gallery grid
const ROW_COUNT = 8;
const rows: (typeof optimizedImages)[] = Array.from(
  { length: ROW_COUNT },
  () => [],
);
optimizedImages.forEach((image, index) => {
  rows[index % ROW_COUNT].push(image);
});
---

<Layout>
  <PageHeader title="Gallery" />
  <section
    class="w-full min-h-[50svh] sm:min-h-96 flex flex-col justify-stretch"
  >
    <div
      id="gallery-loading"
      class="w-full flex-1 flex items-center justify-center py-24"
    >
      <div
        class="w-12 h-12 border-4 border-mauve-200 border-t-red-pastel rounded-full animate-spin"
      >
      </div>
    </div>
    <div
      id="gallery-content"
      class="w-full h-full pt-8 pb-10 sm:pb-22 flex-col flex-1 items-center justify-start gap-2.5 opacity-0 transition-opacity duration-2000"
      style="display: none"
      data-total-images={optimizedImages.length}
    >
      <p
        class="text-xl sm:text-2xl font-(family-name:--font-providence) text-mauve-950 text-center px-4 sm:px-0 sm:max-w-5xl pb-8"
      >
        Scroll through our delightfully adorable pre-wedding photos!
      </p>
      {
        rows.map((row, idx) => (
          <Gallery
            client:only="preact"
            images={row}
            align={idx % 2 ? "start" : "center"}
          />
        ))
      }
      <p
        class="text-xl sm:text-3xl font-(family-name:--font-providence) text-mauve-950 text-center px-4 sm:px-0 sm:max-w-5xl pt-8 sm:pt-12"
      >
        ...what, you thought it was going to be photos of us?
      </p>
    </div>
  </section>
  <Footer />
</Layout>

<script>
  const loadingEl = document.getElementById("gallery-loading");
  const contentEl = document.getElementById("gallery-content");

  if (loadingEl && contentEl) {
    const total = Number(contentEl.dataset.totalImages ?? 0);
    let settled = 0;
    let revealed = false;

    const reveal = () => {
      if (revealed) return;
      revealed = true;
      loadingEl.style.display = "none";
      contentEl.style.display = "flex";
      requestAnimationFrame(() => {
        contentEl.classList.add("opacity-100");
      });
    };

    if (total === 0) {
      reveal();
    } else {
      window.addEventListener("gallery:image-settled", () => {
        settled += 1;
        if (settled >= total) reveal();
      });
      // Safety net in case an image never fires load/error (e.g. a lazy
      // row far below the fold that never enters the viewport). Long
      // enough to not fire during a normal cold-cache full-gallery load.
      setTimeout(reveal, 30000);
    }
  }
</script>
