---
import { Image } from "astro:assets";

import footerImg from "@/assets/images/wedding-logo-2.png";

const asPath = Astro.url.pathname;
---

<footer class="relative w-full overflow-visible">
  <a href="/" class="relative block w-full h-8">
    <Image
      src={footerImg}
      alt="Footer image"
      class="absolute top-8 left-1/2 -translate-x-1/2 -translate-y-1/4 w-32 h-32 object-cover object-top rounded-full z-10"
    />
  </a>
  <div
    id="footer-content-container"
    class="w-full min-h-[50svh] sm:min-h-96 flex flex-col justify-stretch"
  >
    <div
      id="footer-content"
      class="w-full h-full px-4 pt-32 pb-10 bg-crimson flex flex-col flex-1 items-center justify-start gap-2.5"
    >
      <a
        href="/"
        id="foot-header"
        class="text-center text-white text-4xl font-(family-name:--font-roca) font-bold pb-4"
      >
        Sam & Carolina
      </a>
      {asPath === "/" ? null : <a href="/">Home</a>}
      {asPath === "/rsvp" ? null : <a href="/rsvp">RSVP/Guestbook</a>}
      {asPath === "/dress-code" ? null : <a href="/dress-code">Dress Code</a>}
      {
        asPath === "/accommodation" ? null : (
          <a href="/accommodation">Accommodation</a>
        )
      }
      {asPath === "/transport" ? null : <a href="/transport">Transport</a>}
      {asPath === "/faqs" ? null : <a href="/faqs">FAQs</a>}
    </div>
  </div>
</footer>

<style>
  #footer-content-container {
    clip-path: url(#wave-clip-footer-mobile);
  }

  #footer-content-container a:not(#foot-header) {
    display: block;
    text-align: center;
    color: #fff;
    font-size: 1.125rem;
    font-family: var(--font-providence);
    transition:
      color 0.3s ease,
      font-size 0.3s ease;
  }

  #footer-content-container a:not(#foot-header):hover {
    color: #f5f1ed;
    font-size: 1.2rem;
  }

  @media (min-width: 768px) {
    #footer-content-container {
      clip-path: url(#wave-clip-footer);
    }
  }
</style>

<svg width="0" height="0">
  <defs>
    <clipPath id="wave-clip-footer" clipPathUnits="objectBoundingBox">
      <path
        d="M 1,1 L 1,0.05 C 0.75,0.05 0.75,0 0.5,0 C 0.25,0 0.25,0.05 0,0.05 L 0,1 Z"
      ></path>
    </clipPath>
    <clipPath id="wave-clip-footer-mobile" clipPathUnits="objectBoundingBox">
      <path d="M 1,1 L 1,0.02 Q 0.5,0 0,0.02 L 0,1 Z"></path>
    </clipPath>
  </defs>
</svg>
